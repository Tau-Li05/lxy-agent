{
  "schema_version": "3.0",
  "dataset": {
    "name": "locomo",
    "path": "../../../data/evaluation/locomo_10pct.jsonl"
  },
  "task_family": "multiturn",
  "runtime": {
    "kind": "qwen_harness"
  },
  "agent": {
    "max_steps": 1,
    "sample_timeout_seconds": 3600
  },
  "tool": {
    "enabled": false,
    "provider": "none",
    "schema_source": "none",
    "execution": "disabled"
  },
  "model": {
    "profiles": {
      "qwen3_5_4b": {
        "provider": "ollama",
        "name": "qwen3.5:4b",
        "context_window": 131072,
        "max_tokens": 512,
        "temperature": 0,
        "host": "http://127.0.0.1:11434",
        "host_env": "OLLAMA_HOST"
      }
    },
    "default_profile": "qwen3_5_4b",
    "reasoning": {
      "enabled": false,
      "mode": "high"
    }
  },
  "prompt": {
    "system": "Answer each LoCoMo question using only the episodic memory and its source dialogue. If the evidence is insufficient, answer exactly: No information available. Return only the short answer."
  },
  "features": {
    "tools": {
      "enabled": false,
      "execution": false
    },
    "planning": {
      "enabled": false
    },
    "verification": {
      "enabled": false
    },
    "compaction": {
      "enabled": false
    },
    "self_correction": {
      "enabled": false
    },
    "web_search": {
      "enabled": false
    },
    "memory": {
      "enabled": true,
      "mode": "remem_v1",
      "top_k": 5,
      "max_chars": 12000,
      "embedding_provider": "ollama",
      "embedding_model": "qwen3-embedding:0.6b",
      "use_gists": false,
      "use_time": true,
      "use_graph": true,
      "graph_steps": 1,
      "graph_extra": 5,
      "use_vector": true,
      "use_raw_backtrace": true,
      "include_dates": true,
      "include_speakers": true,
      "include_image_captions": true
    },
    "math_tools": {
      "mode": "none"
    },
    "output_recovery": {
      "enabled": false,
      "max_retries": 0
    }
  },
  "retry": {
    "timeout": {
      "enabled": true,
      "max_retries": 2
    },
    "transport": {
      "enabled": true,
      "max_retries": 2
    },
    "malformed_response": {
      "enabled": false,
      "max_retries": 0
    }
  },
  "limits": {
    "max_model_turns": 1,
    "max_tool_calls": 0,
    "max_total_tokens": 262144
  }
}
