{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-input-v1.schema.json",
  "title": "Unified AgentInput v1",
  "type": "object",
  "required": ["id", "messages", "tools", "attachments", "environment", "metadata"],
  "properties": {
    "id": {"type": "string"},
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
    "tools": {"type": "array", "items": {"type": "object"}},
    "attachments": {"type": "array", "items": {"$ref": "#/$defs/attachment"}},
    "environment": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {"role": {"enum": ["system", "user", "assistant", "tool"]}, "content": {"type": "string"}, "name": {"type": "string"}, "tool_call_id": {"type": "string"}},
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": ["path"],
      "properties": {"path": {"type": "string"}, "name": {"type": "string"}, "media_type": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": false
    }
  }
}

