{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-config-v2.schema.json",
  "type": "object",
  "required": ["schema_version", "dataset", "task_family", "agent", "tool", "model", "prompt"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0"},
    "dataset": {
      "type": "object", "required": ["name", "path"], "additionalProperties": false,
      "properties": {"name": {"enum": ["gsm8k", "aime", "bfcl", "locomo"]}, "path": {"type": "string", "minLength": 1}}
    },
    "task_family": {"enum": ["single_turn", "multiturn"]},
    "agent": {
      "type": "object", "required": ["runtime", "max_steps", "sample_timeout_seconds"], "additionalProperties": false,
      "properties": {
        "runtime": {"const": "langchain"}, "max_steps": {"type": "integer", "minimum": 1},
        "sample_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "tool": {
      "type": "object", "required": ["enabled", "provider", "schema_source", "execution"], "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}, "provider": {"enum": ["none", "bfcl", "locomo_memory"]},
        "schema_source": {"enum": ["none", "dataset"]}, "execution": {"enum": ["disabled", "enabled"]}
      }
    },
    "model": {
      "type": "object", "required": ["profiles", "default_profile", "reasoning"], "additionalProperties": false,
      "properties": {
        "profiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/profile"}},
        "default_profile": {"type": "string", "minLength": 1},
        "reasoning": {
          "type": "object", "required": ["enabled", "mode"], "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "mode": {"enum": ["low", "medium", "high"]}}
        }
      }
    },
    "prompt": {
      "type": "object", "required": ["system"], "additionalProperties": false,
      "properties": {"system": {"type": "string"}}
    }
  },
  "$defs": {
    "profile": {
      "type": "object", "required": ["name", "context_window", "max_tokens", "temperature"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["openai_compatible", "ollama"]},
        "name": {"type": "string", "minLength": 1},
        "context_window": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number"}, "base_url_env": {"type": "string", "minLength": 1},
        "api_key_env": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "host_env": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"provider": {"const": "ollama"}}, "required": ["provider"]},
          "then": {"not": {"required": ["api_key_env"]}},
          "else": {"required": ["base_url_env", "api_key_env"]}
        }
      ]
    }
  }
}
