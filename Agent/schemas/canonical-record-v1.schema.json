{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical-record-v1.schema.json",
  "title": "Canonical Benchmark Record v1",
  "description": "用于从原始 Benchmark 派生 SFT、RL 和 TEST 数据视图的统一中间记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "benchmark",
    "source",
    "split",
    "usage",
    "task_type",
    "input",
    "target",
    "reward",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "Canonical Record Schema 版本。"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s:]+:[^\\s:]+:.+$",
      "description": "跨处理阶段保持稳定的全局 ID，推荐格式为 benchmark:split:source_id_or_hash。"
    },
    "benchmark": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Benchmark 稳定标识，与 Benchmark YAML 中 benchmark.id 一致。"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "split": {
      "enum": ["train", "validation", "test"],
      "description": "项目统一语义下的切分；不盲从上游名称，例如 AIME26 应映射为 test。"
    },
    "usage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["sft", "rl", "test"]
      },
      "description": "允许从本记录派生的数据视图。test 记录不得因此把答案暴露给模型输入。"
    },
    "task_type": {
      "enum": [
        "math_reasoning",
        "question_answering",
        "function_calling",
        "agentic_question_answering"
      ],
      "description": "任务协议类别；需要新类别时应升级 Schema 或显式扩展枚举。"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/target"},
        {"type": "null"}
      ],
      "description": "监督目标。隐藏答案测试集允许为 null。生成 TEST input view 时必须移除此字段。"
    },
    "reward": {
      "oneOf": [
        {"$ref": "#/$defs/reward"},
        {"type": "null"}
      ],
      "description": "机器可执行的评分或 RL 奖励协议；无本地评分协议时允许为 null。"
    },
    "metadata": {
      "type": "object",
      "description": "难度、类别、年份、发布时间等不改变核心执行协议的扩展元数据。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "usage": {"contains": {"const": "sft"}}
        },
        "required": ["usage"]
      },
      "then": {
        "properties": {
          "target": {
            "allOf": [
              {"$ref": "#/$defs/target"},
              {"required": ["response"]}
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage": {"contains": {"const": "rl"}}
        },
        "required": ["usage"]
      },
      "then": {
        "properties": {
          "reward": {"$ref": "#/$defs/reward"}
        }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "description": "任意 JSON 值，用于兼容文本答案和 BFCL 等结构化答案。",
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "dataset_version", "source_split", "source_id", "source_path", "row_index"],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "description": "上游数据集名称。"
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1,
          "description": "上游数据版本、revision 或本地快照标识。"
        },
        "source_split": {
          "type": "string",
          "minLength": 1,
          "description": "上游原始 split 名称，可与统一 split 不同。"
        },
        "source_id": {
          "type": ["string", "integer", "null"],
          "description": "上游提供的原始 ID；上游无 ID 时为 null。"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "description": "相对于数据根目录的原始文件路径。"
        },
        "row_index": {
          "type": "integer",
          "minimum": 0,
          "description": "记录在原始文件中的零基行号，用于追溯。"
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "对规范化原始记录计算的 SHA-256，用于无原始 ID 时生成稳定 ID。"
        },
        "license": {
          "type": ["string", "null"],
          "description": "该记录继承的数据许可证。"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {
          "enum": ["system", "user", "assistant", "tool"],
          "description": "消息角色。"
        },
        "content": {
          "type": "string",
          "description": "消息文本；不得嵌入标准答案，除非它本来就是题面的一部分。"
        },
        "name": {
          "type": "string",
          "description": "可选的参与者或工具名称。"
        },
        "tool_call_id": {
          "type": "string",
          "description": "tool 消息所对应的调用 ID。"
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "相对于数据根目录的附件路径。"
        },
        "name": {
          "type": "string",
          "description": "附件显示名称。"
        },
        "media_type": {
          "type": "string",
          "description": "附件 MIME 类型。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "附件内容 SHA-256。"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "tools", "attachments", "environment"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/message"},
          "description": "提供给模型或 Agent 的输入消息。"
        },
        "tools": {
          "type": "array",
          "items": {"type": "object"},
          "description": "当前样本声明的工具定义。"
        },
        "attachments": {
          "type": "array",
          "items": {"$ref": "#/$defs/attachment"},
          "description": "当前样本的附件列表。"
        },
        "environment": {
          "type": "object",
          "description": "多轮工具任务的初始环境状态；普通数学题使用空对象。"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response": {
          "type": ["string", "null"],
          "description": "完整参考回复或推理过程，主要供 SFT 使用。"
        },
        "final_answer": {
          "$ref": "#/$defs/jsonValue",
          "description": "用于评测的最终答案；可以是字符串或结构化 JSON。"
        },
        "tool_calls": {
          "type": "array",
          "items": {"type": "object"},
          "description": "函数调用任务的参考工具调用。"
        },
        "final_state": {
          "type": ["object", "null"],
          "description": "状态型 Agent 任务的预期最终环境状态。"
        }
      },
      "anyOf": [
        {"required": ["response"]},
        {"required": ["final_answer"]},
        {"required": ["tool_calls"]},
        {"required": ["final_state"]}
      ]
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "normalization"],
      "properties": {
        "type": {
          "enum": [
            "exact_match",
            "numeric_exact_match",
            "math_equivalence",
            "list_exact_match",
            "official_evaluator",
            "remote_evaluator"
          ],
          "description": "奖励或评分实现的注册类型。"
        },
        "reference": {
          "$ref": "#/$defs/jsonValue",
          "description": "评分参考答案。远程隐藏答案或官方 evaluator 可设为 null。"
        },
        "normalization": {
          "type": "array",
          "items": {"type": "string"},
          "description": "比较前按顺序执行的规范化步骤。"
        },
        "answer_extractor": {
          "type": ["string", "null"],
          "description": "从模型完整回复中提取最终答案的注册器名称。"
        },
        "evaluator_version": {
          "type": ["string", "null"],
          "description": "评分实现版本。"
        },
        "parameters": {
          "type": "object",
          "description": "评分器专用参数，不得存储密钥。"
        }
      }
    }
  }
}

