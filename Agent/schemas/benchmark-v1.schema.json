{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-v1.schema.json",
  "title": "Agent Benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "benchmark", "dataset", "input_adapter", "agent_contract", "execution_environment", "runtime", "output_adapter", "submission", "evaluator"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "benchmark"},
    "benchmark": {"$ref": "#/$defs/benchmarkIdentity"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "input_adapter": {"$ref": "#/$defs/adapter"},
    "agent_contract": {"$ref": "#/$defs/agentContract"},
    "execution_environment": {"$ref": "#/$defs/environment"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "output_adapter": {"$ref": "#/$defs/adapter"},
    "reference_adapter": {"$ref": "#/$defs/adapter"},
    "submission": {"$ref": "#/$defs/submission"},
    "evaluator": {"$ref": "#/$defs/evaluator"},
    "reproducibility": {
      "type": "object",
      "required": ["random_seed", "shuffle"],
      "properties": {"random_seed": {"type": "integer"}, "shuffle": {"type": "boolean"}},
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {"homepage": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]}, "citation": {"type": ["string", "null"]}},
      "additionalProperties": false
    }
  },
  "$defs": {
    "benchmarkIdentity": {
      "type": "object",
      "required": ["id", "version", "protocol_version", "description", "task_type", "tags"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "version": {"type": "string"},
        "protocol_version": {"type": "string"},
        "description": {"type": "string"},
        "task_type": {"type": "string"},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["loader", "integrity", "sample_id", "fields"],
      "properties": {
        "loader": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["parquet", "jsonl", "huggingface_disk", "python", "bfcl_v4"]}}, "additionalProperties": true},
        "integrity": {
          "type": "object",
          "required": ["expected_samples", "sha256"],
          "properties": {
            "expected_samples": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "sha256": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
          },
          "additionalProperties": false
        },
        "sample_id": {
          "type": "object",
          "required": ["field", "strategy"],
          "properties": {"field": {"type": ["string", "null"]}, "strategy": {"enum": ["field", "content_hash", "row_index"]}},
          "additionalProperties": false
        },
        "fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "filters": {"type": "array"}
      },
      "additionalProperties": false
    },
    "adapter": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "agentContract": {
      "type": "object",
      "required": ["input_schema", "output_schema", "required_capabilities", "allowed_tools"],
      "properties": {
        "input_schema": {"const": "agent-input/v1"},
        "output_schema": {"const": "agent-output/v1"},
        "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["dependencies", "sandbox"],
      "properties": {
        "dependencies": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["current_environment", "venv", "conda", "image", "editable_project"]}}, "additionalProperties": true},
        "sandbox": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["none", "process", "docker"]}}, "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["limits", "accounting"],
      "properties": {
        "limits": {
          "type": "object",
          "required": ["max_turns", "max_steps", "max_tool_calls", "tokens", "time"],
          "properties": {
            "max_turns": {"type": "integer", "minimum": 1},
            "max_steps": {"type": "integer", "minimum": 1},
            "max_tool_calls": {"type": "integer", "minimum": 0},
            "tokens": {"type": "object", "required": ["max_total", "max_output_per_call"], "properties": {"max_total": {"type": "integer", "minimum": 1}, "max_output_per_call": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
            "time": {"type": "object", "required": ["sample_timeout_seconds", "tool_call_timeout_seconds"], "properties": {"sample_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}, "tool_call_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false}
          },
          "additionalProperties": false
        },
        "accounting": {
          "type": "object",
          "required": ["failed_tool_calls", "parallel_tool_calls", "cached_model_calls"],
          "properties": {"failed_tool_calls": {"enum": ["count", "ignore"]}, "parallel_tool_calls": {"enum": ["per_call", "per_batch"]}, "cached_model_calls": {"enum": ["count", "ignore"]}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["builder", "output"],
      "properties": {
        "builder": {"type": "object", "required": ["type", "required_fields"], "properties": {"type": {"type": "string"}, "required_fields": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
        "field_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
        "output": {"type": "object", "minProperties": 1}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["id", "primary", "direction", "range"],
      "properties": {"id": {"type": "string"}, "primary": {"type": "boolean"}, "direction": {"enum": ["maximize", "minimize"]}, "range": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}},
      "additionalProperties": false
    },
    "evaluator": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["sample", "submission", "remote_submission", "split"]},
        "type": {"enum": ["builtin", "command", "http", "remote_submission"]},
        "implementation": {"type": "string"},
        "version": {"type": "string"},
        "prediction_field": {"type": "string"},
        "reference_field": {"type": "string"},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "routes": {"type": "object", "additionalProperties": {"type": "object"}},
        "working_directory": {"type": "string"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true,
      "allOf": [
        {"if": {"required": ["mode"], "properties": {"mode": {"const": "split"}}}, "then": {"required": ["routes"]}},
        {"if": {"required": ["type"], "properties": {"type": {"const": "command"}}}, "then": {"required": ["command"]}}
      ]
    }
  }
}

