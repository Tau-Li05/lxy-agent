{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-metrics-v1.schema.json",
  "title": "Benchmark Metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "evaluation_scope", "split", "total", "correct", "accuracy", "status_counts", "by_level", "by_category", "by_level_category"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {"const": "competition_math"},
    "evaluation_scope": {"const": "development"},
    "split": {"const": "validation"},
    "total": {"type": "integer", "minimum": 1},
    "correct": {"type": "integer", "minimum": 0},
    "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "by_level": {"$ref": "#/$defs/groups"},
    "by_category": {"$ref": "#/$defs/groups"},
    "by_level_category": {"$ref": "#/$defs/groups"}
  },
  "$defs": {
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["total", "correct", "accuracy", "status_counts"],
        "properties": {
          "total": {"type": "integer", "minimum": 1},
          "correct": {"type": "integer", "minimum": 0},
          "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
          "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
        },
        "additionalProperties": false
      }
    }
  }
}
