{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-config-v1.schema.json",
  "title": "LangChain Agent Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "runtime", "model", "system_prompt"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "limits"],
      "properties": {
        "type": {"const": "langchain_create_agent"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["concurrency", "max_turns", "max_tool_calls", "max_steps", "sample_timeout_seconds"],
          "properties": {
            "concurrency": {"type": "integer", "minimum": 1},
            "max_turns": {"const": 1},
            "max_tool_calls": {"const": 0},
            "max_steps": {"type": "integer", "minimum": 1},
            "sample_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_env", "base_url_env", "api_key_env", "temperature", "max_retries", "max_output_tokens"],
      "properties": {
        "provider": {"const": "openai_compatible"},
        "model_env": {"type": "string", "minLength": 1},
        "base_url_env": {"type": "string", "minLength": 1},
        "api_key_env": {"type": "string", "minLength": 1},
        "temperature": {"type": "number"},
        "max_retries": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "system_prompt": {"type": "string"}
  }
}
