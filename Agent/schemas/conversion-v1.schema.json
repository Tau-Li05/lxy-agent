{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"conversion-v1.schema.json","title":"Dataset Conversion Config v1",
  "type":"object","additionalProperties":true,
  "required":["schema_version","benchmark","dataset_version","adapter","task_type","sources","expected_source_samples","source_sha256","usage_by_split"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "benchmark":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},
    "dataset_version":{"type":"string","minLength":1},
    "adapter":{"enum":["competition_math","math_jsonl","livebench_math"]},
    "task_type":{"enum":["math_reasoning","question_answering","function_calling","agentic_question_answering"]},
    "license":{"type":["string","null"]},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["path","source_split"],"properties":{"path":{"type":"string","minLength":1},"source_split":{"type":"string","minLength":1},"split":{"enum":["train","validation","test"]}},"additionalProperties":false}},
    "expected_source_samples":{"type":"integer","minimum":1},
    "source_sha256":{"oneOf":[{"type":"string","pattern":"^[a-f0-9]{64}$"},{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}}]},
    "usage_by_split":{"type":"object","minProperties":1,"additionalProperties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["sft","rl","test"]}}},
    "split_policy":{"type":"object"}
  }
}

