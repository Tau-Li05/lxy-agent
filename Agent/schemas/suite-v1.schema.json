{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "suite-v1.schema.json",
  "title": "Agent Benchmark Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "suite", "benchmarks", "report"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "suite"},
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "version": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "defaults": {"type": "object"},
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config"],
        "properties": {
          "config": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean", "default": true},
          "splits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "limit": {"type": ["integer", "null"], "minimum": 1},
          "weight": {"type": "number", "minimum": 0},
          "overrides": {"type": "object"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "concurrency": {"type": "integer", "minimum": 1},
        "fail_fast": {"type": "boolean"},
        "random_seed": {"type": "integer"}
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composite_score": {"type": ["object", "null"]},
        "missing_result_policy": {"enum": ["error", "skip", "zero"]}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_directory", "formats"],
      "properties": {
        "output_directory": {"type": "string"},
        "formats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["json", "jsonl"]}},
        "include_per_sample_results": {"type": "boolean"},
        "include_resolved_config": {"type": "boolean"}
      }
    }
  }
}

