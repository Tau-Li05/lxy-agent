{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-output-v1.schema.json",
  "title": "Unified AgentOutput v1",
  "type": "object",
  "required": ["id", "status", "final_answer", "messages", "tool_calls", "artifacts", "usage", "timing", "error", "metadata"],
  "properties": {
    "id": {"type": "string"},
    "status": {"enum": ["success", "invalid_input", "runtime_error", "timeout", "limit_exceeded", "invalid_prediction", "evaluator_error", "skipped", "error"]},
    "final_answer": {"type": ["string", "null"]},
    "messages": {"type": "array", "items": {"type": "object"}},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "usage": {
      "type": "object",
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "properties": {"prompt_tokens": {"type": "integer", "minimum": 0}, "completion_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}},
      "additionalProperties": false
    },
    "timing": {"type": "object", "required": ["duration_seconds"], "properties": {"duration_seconds": {"type": "number", "minimum": 0}}, "additionalProperties": true},
    "error": {"type": ["object", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}

